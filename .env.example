# Use a READ-ONLY key. fp_test_... = sandbox, fp_live_... = live (picked automatically).
FP_API_KEY=fp_test_your_key_here
# Optional: only track one account (find IDs with: python fp_copilot.py accounts)
# FP_ACCOUNT_ID=
# Day boundaries for `summary` (IANA timezone name). Default UTC.
FP_TZ=Asia/Kolkata
# Alert when this % of the daily-loss / max-drawdown allowance is used
FP_WARN_PCT=70
FP_DANGER_PCT=90
# Seconds between risk refreshes while a position is open (events trigger extra refreshes)
FP_RISK_REFRESH_SECS=10
# Optional alert channels
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
